{
  "name": "@ctgcode/tooltip",
  "version": "1.0.0",
  "description": "Tooltip Web Component that works in React, Vue, Angular, Astro or plain HTML.",
  "type": "module",
  "license": "MIT",
  "author": "CTG CODE SAS",
  "homepage": "https://github.com/ctgcodesas/ctg-tooltip#readme",
  "bugs": {
    "url": "https://github.com/ctgcodesas/ctg-tooltip/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ctgcodesas/ctg-tooltip.git"
  },
  "keywords": [
    "tooltip",
    "web-component",
    "custom-element",
    "lit"
  ],
  "main": "./dist/ctg-tooltip.js",
  "module": "./dist/ctg-tooltip.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/ctg-tooltip.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": true,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.8.0",
    "lit": "^3.3.0"
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "vite": "^8.3.5"
  }
}
